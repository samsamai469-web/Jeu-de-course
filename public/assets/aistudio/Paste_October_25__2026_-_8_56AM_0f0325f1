const AI_COLORS = ['#2563eb', '#9333ea', '#e11d48', '#eab308', '#0d9488', '#ea580c', '#16a34a'];

// ============================================================================
// CAR STEERING & STABILITY PHYSICS (Ported directly from Unity CarSteering)
// Features: Ackermann geometry, Speed-dependent steering curve, Asymmetric
// steer/return rates, Counter-steer drift assist, Downforce & Anti-Roll
// ============================================================================

// 1. Angle max piloté par une courbe selon la vitesse (km/h -> degrés)
// Keyframes: (0, 35°), (60, 22°), (120, 10°), (200, 5°)
export function evalMaxAngleBySpeed(speedKmh: number): number {
  if (speedKmh <= 0) return 35.0;
  if (speedKmh <= 60.0) return THREE.MathUtils.lerp(35.0, 22.0, speedKmh / 60.0);
  if (speedKmh <= 120.0) return THREE.MathUtils.lerp(22.0, 10.0, (speedKmh - 60.0) / 60.0);
  if (speedKmh <= 200.0) return THREE.MathUtils.lerp(10.0, 5.0, (speedKmh - 120.0) / 80.0);
  return THREE.MathUtils.lerp(5.0, 3.8, Math.min(1.0, (speedKmh - 200.0) / 140.0));
}

// 2. Lissage de l'entrée avec rotation (150°/s) et retour au centre rapide (280°/s)
export function updateCarSteerAngle(
  currentAngleDeg: number,
  steerInput: number, // -1 (gauche) à +1 (droite)
  speedKmh: number,
  dt: number,
  sensitivity = 1.0,
  steerRate = 150.0,
  returnRate = 280.0,
  highSpeedDamping = 0.5,
  highSpeedKmh = 180.0
): number {
  const maxAngle = evalMaxAngleBySpeed(speedKmh) * sensitivity;
  const target = THREE.MathUtils.clamp(steerInput * maxAngle, -maxAngle, maxAngle);

  // Retour au centre ou changement de sens : réaction plus rapide (returnRate)
  const returning = Math.abs(steerInput) < 0.01 || Math.sign(steerInput) !== Math.sign(currentAngleDeg);

  const speedFactor = THREE.MathUtils.lerp(1.0, 1.0 - highSpeedDamping, THREE.MathUtils.clamp(speedKmh / highSpeedKmh, 0, 1));
  const rate = (returning ? returnRate : steerRate) * speedFactor;

  // Mathf.MoveTowards
  const diff = target - currentAngleDeg;
  if (Math.abs(diff) <= rate * dt) {
    return target;
  }
  return currentAngleDeg + Math.sign(diff) * rate * dt;
}

// 3. Aide au contre-braquage automatique en cas de dérapage (désactivée en marche arrière)
export function computeCounterSteer(
  slipAngleDeg: number,
  speedMs: number,
  isReversing: boolean,
  counterSteerAssist = 0.35,
  assistMinSpeed = 8.0 / 3.6, // 8 km/h en m/s
  assistMaxCorrection = 20.0
): number {
  if (counterSteerAssist <= 0 || speedMs < assistMinSpeed || isReversing) {
    return 0;
  }

  const clampedSlip = THREE.MathUtils.clamp(slipAngleDeg, -assistMaxCorrection, assistMaxCorrection);
  return clampedSlip * counterSteerAssist;
}

// 4. Géométrie d'Ackermann (la roue intérieure braque plus fort que la roue extérieure)
export function applyAckermann(
  angleDeg: number,
  wheelBase = 2.6,
  trackWidth = 1.5
): { leftDeg: number; rightDeg: number; avgRad: number } {
  const limit = evalMaxAngleBySpeed(0); // 35°
  const clampedAngleDeg = THREE.MathUtils.clamp(angleDeg, -limit, limit);

  if (Math.abs(clampedAngleDeg) < 0.01) {
    return { leftDeg: 0, rightDeg: 0, avgRad: 0 };
  }

  const angleRad = Math.abs(clampedAngleDeg) * (Math.PI / 180.0);
  const radius = wheelBase / Math.tan(angleRad);
  const half = trackWidth * 0.5;
  const innerRad = Math.atan(wheelBase / Math.max(radius - half, 0.01));
  const outerRad = Math.atan(wheelBase / (radius + half));

  const innerDeg = innerRad * (180.0 / Math.PI);
  const outerDeg = outerRad * (180.0 / Math.PI);

  if (clampedAngleDeg > 0) {
    // Braquage à droite : roue droite intérieure, roue gauche extérieure
    return {
      leftDeg: outerDeg,
      rightDeg: innerDeg,
      avgRad: (innerRad + outerRad) * 0.5,
    };
  } else {
    // Braquage à gauche : roue gauche intérieure, roue droite extérieure
    return {
      leftDeg: -innerDeg,
      rightDeg: -outerDeg,
      avgRad: -(innerRad + outerRad) * 0.5,
    };
  }
}

